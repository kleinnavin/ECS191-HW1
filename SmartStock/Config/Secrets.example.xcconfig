// Template for Secrets.xcconfig (which is git-ignored).
// cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// then replace the placeholders below.
FINNHUB_API_KEY = your_finnhub_api_key_here

// Host of the SmartStock Insights Worker (see insights-worker/README.md),
// without "https://" -- xcconfig files treat "//" as the start of a comment.
// The Anthropic API key lives in the Worker, not in the app.
INSIGHTS_API_HOST = your-worker.your-subdomain.workers.dev
